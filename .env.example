# ============================================================================
# BESMAINFOENERGY — CONFIGURATION D'ENVIRONNEMENT (CONFORME LOI ALGÉRIENNE 18-07)
# ============================================================================

# Clé API Gemini (Injectée côté serveur uniquement pour l'analyse IA contextuelle)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TEMPERATURE="0.2"

# URL de l'application
APP_URL="http://localhost:3000"
PORT="3000"

# ============================================================================
# FIREBASE & CLOUD MESSAGING (FCM / ALERTES TEMPS RÉEL)
# ============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIREBASE_SENDER_ID="1040592056755"
VITE_FIREBASE_API_KEY="VOTRE_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="besma-info-energy.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="besma-info-energy"
VITE_FIREBASE_STORAGE_BUCKET="besma-info-energy.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1040592056755"
VITE_FIREBASE_APP_ID="VOTRE_FIREBASE_APP_ID"
VITE_FIREBASE_VAPID_KEY="VOTRE_CLE_PUBLIQUE_VAPID"

# ============================================================================
# EXPORT SIGNÉ DES JOURNAUX D'AUDIT (LOI 18-07 / RSA-4096 & RFC 3161)
# ============================================================================
AUDIT_SIGNING_KEY_PATH=./keys/audit_signing_key.pem
AUDIT_PUBLIC_KEY_PATH=./keys/audit_public_key.pem
AUDIT_TSA_URL=https://freetsa.org/tsr
AUDIT_EXPORT_MAX_ROWS=100000

# ============================================================================
# CONFIGURATION DYNAMIQUE DES SEUILS D'ALERTE PAR ZONE (SONELGAZ)
# ============================================================================
THRESHOLD_RELOAD_INTERVAL_SECONDS=60
THRESHOLD_DEFAULT_SEASON=all
THRESHOLD_ENABLE_SIMULATION=true

# ============================================================================
# ANALYTIQUE 24H, DÉTECTION STATISTIQUE (Z-SCORE) & TOPOLOGIE D3.JS
# ============================================================================
ANALYTICS_AGGREGATION_WINDOW_MINUTES=5
ANALYTICS_ANOMALY_ZSCORE_THRESHOLD=3.0
ANALYTICS_MAX_POINTS_RETURNED=1000
ANALYTICS_CACHE_TTL_SECONDS=30

# ============================================================================
# PROJECTION ML DE PROBABILITÉ DE PANNE À 48H & INTERVENTIONS PRÉVENTIVES
# ============================================================================
FORECAST_HORIZON_HOURS=48
FORECAST_RETRAIN_INTERVAL_HOURS=24
FORECAST_CONFIDENCE_LEVEL=0.95
FORECAST_MODEL_DIR=./models
FORECAST_FCM_THRESHOLD=0.70
FORECAST_SCADA_THRESHOLD=0.90

# ============================================================================
# FALLBACK SMS SOUVERAIN POUR ALERTES CRITIQUES (OOREDOO / MOBILIS / DJEZZY)
# ============================================================================
SMS_PROVIDER=mock
SMS_OOREDOO_API_URL=
SMS_OOREDOO_API_KEY=
SMS_OOREDOO_SENDER_ID=BESMAINFO
SMS_MOBILIS_API_URL=
SMS_MOBILIS_API_KEY=
SMS_MOBILIS_SENDER_ID=BESMAINFO
SMS_DJEZZY_API_URL=
SMS_DJEZZY_API_KEY=
SMS_DJEZZY_SENDER_ID=BESMAINFO
SMS_FALLBACK_TIMEOUT_SECONDS=60
SMS_MAX_LENGTH=160
SMS_DAILY_LIMIT=500
SMS_RETRY_ATTEMPTS=2

# ============================================================================
# SÉCURITÉ & AUTHENTIFICATION JWT (RBAC : admin, operateur, lecteur)
# ============================================================================
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION_WITH_256_BIT_HEX_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Base de données MongoDB (Hébergement local SONELGAZ / Datacenter National DZ)
MONGODB_URI="mongodb://localhost:27017/besmainfoenergy"
MONGODB_DB_NAME="besmainfoenergy_dz"

# Ingestion Temps Réel (MQTT / Apache Kafka)
INGESTION_BROKER_TYPE="MQTT"
MQTT_BROKER_HOST="mqtt.interne.sonelgaz.dz"
MQTT_BROKER_PORT="8883"
MQTT_TOPIC_ELECTRICITY="sonelgaz/grid/electricity/#"
MQTT_TOPIC_GAS="sonelgaz/grid/gas/#"
KAFKA_BOOTSTRAP_SERVERS="kafka-01.interne.sonelgaz.dz:9092"

# Google Cloud Platform (Mode Démonstration Autorisé / Cloud Hybride)
GCP_PROJECT_ID="besma-info-energy"
GCP_PUBSUB_TOPIC="energy-telemetry-stream"
GCP_BIGQUERY_DATASET="energy_analytics_dz"

# Conformité Loi 18-07 (Protection des données personnelles en Algérie)
DATA_SOVEREIGNTY_MODE="LOCAL_DZ_STRICT"
ANONYMIZE_CONSUMER_PII="true"
AUDIT_LOG_RETENTION_DAYS="365"
